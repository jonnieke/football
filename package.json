{
  "name": "football-content-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "verify:vercel": "node scripts/verify-vercel.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "dev": "concurrently -k -n api,ingestion,events,content,outbox \"pnpm --filter @fcp/api dev\" \"pnpm --filter @fcp/football-ingestion dev\" \"pnpm --filter @fcp/event-processor dev\" \"pnpm --filter @fcp/content-generator dev\" \"pnpm --filter @fcp/outbox-dispatcher dev\"",
    "outbox:recover": "tsx scripts/outbox-recovery.ts",
    "monitor:check": "tsx scripts/monitor-check.ts",
    "workers:check": "tsx scripts/workers-check.ts",
    "alert:recipients": "tsx scripts/alert-recipients.ts",
    "alerts:matches": "tsx scripts/match-email-worker.ts",
    "source:review": "tsx scripts/source-reviews.ts",
    "feed:reset-cursors": "tsx scripts/reset-feed-cursors.ts",
    "lint": "eslint .",
    "audit:dependencies": "pnpm audit --audit-level low",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run packages tests/unit",
    "test:integration": "node scripts/run-integration.mjs",
    "test:workers": "node scripts/run-worker-tests.mjs",
    "sandbox:check": "tsx scripts/test-sandbox.ts --check",
    "sandbox:test": "tsx scripts/test-sandbox.ts --integration",
    "sandbox:workers": "tsx scripts/test-sandbox.ts --workers",
    "sandbox:collector": "tsx scripts/test-sandbox.ts --collector",
    "sandbox:pipeline": "tsx scripts/test-sandbox.ts --pipeline",
    "sandbox:capture": "tsx scripts/capture-match.ts --capture",
    "sandbox:replay": "tsx scripts/replay-match.ts",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/src/seed.ts",
    "api-key:create": "tsx scripts/create-api-key.ts",
    "api-key:revoke": "tsx scripts/revoke-api-key.ts",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@prisma/client": "7.10.0",
    "@types/node": "24.3.0",
    "concurrently": "9.2.1",
    "dotenv": "17.2.2",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "ioredis": "6.0.0",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "uuid": "14.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "concurrently>shell-quote": "1.11.0",
      "@prisma/config>deepmerge-ts": "8.0.2",
      "prisma>mysql2": "3.24.3",
      "json-schema-resolver>fast-uri": "4.2.3",
      "vite": "7.3.7",
      "minimatch>brace-expansion": "5.0.12",
      "fast-uri@>=4.0.0 <4.1.4": ">=4.1.4",
      "fast-uri@>=3.0.0 <3.1.7": ">=3.1.7",
      "fast-uri@=4.1.3": ">=4.1.4",
      "fast-uri@=3.1.6": ">=3.1.7",
      "fast-uri@>=4.0.0 <4.1.5": ">=4.1.5",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8",
      "fast-uri@>=4.1.3 <4.1.5": ">=4.1.5",
      "brace-expansion@<1.1.21": ">=1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": ">=2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "brace-expansion@<1.1.20": ">=1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": ">=2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": ">=5.0.11",
      "brace-expansion@<1.1.19": ">=1.1.19",
      "brace-expansion@>=2.0.0 <2.1.5": ">=2.1.5",
      "brace-expansion@>=4.0.0 <5.0.10": ">=5.0.10",
      "fastify@<5.12.5": ">=5.12.5",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "shell-quote@>=1.8.4 <1.11.0": ">=1.11.0",
      "vite@>=7.0.0 <=7.3.6": ">=7.3.7",
      "@vitest/mocker@>=2.1.0-beta.7 <4.1.12": ">=4.1.12",
      "@vitest/mocker@>=4.1.11 <4.1.12": ">=4.1.12",
      "fastify@>=5.12.2 <5.12.6": ">=5.12.6",
      "zod@<4.6.6": ">=4.6.6",
      "fast-uri@>=4.0.0 <4.2.3": ">=4.2.3",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9",
      "fast-uri@>=4.0.1 <4.2.3": ">=4.2.3",
      "fast-uri@>=3.1.3 <3.1.9": ">=3.1.9",
      "glob@>=9.0.0 <=14.0.1": ">=14.0.2",
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1"
    }
  }
}
