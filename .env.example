NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://football:football@localhost:5432/football_content
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bull
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=replace-me
API_FOOTBALL_TIMEOUT_MS=10000
API_FOOTBALL_MAX_RETRIES=3
LIVE_POLL_INTERVAL_SECONDS=15
SCHEDULE_POLL_INTERVAL_SECONDS=900
RECONCILE_BATCH_SIZE=100
SHORT_CONTENT_MAX_LENGTH=160
DEFAULT_API_RATE_LIMIT=120
API_AUTH_IP_LIMIT=600
API_AUTH_PREFIX_LIMIT=600
API_AUTH_CONCURRENCY=4
# Comma-separated verified proxy IPs/CIDRs only; empty ignores forwarded headers.
API_TRUSTED_PROXIES=
WORKER_HEARTBEAT_TTL_SECONDS=60
CURSOR_SIGNING_SECRET=replace-with-at-least-32-random-characters
