generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

model WorkOutbox {
  id            String   @id @db.Uuid
  kind          String
  dedupeKey     String   @unique @map("dedupe_key")
  payload       Json
  preparedData  Json?    @map("prepared_data")
  attempts      Int      @default(0)
  availableAt   DateTime @default(now()) @map("available_at")
  completedAt   DateTime? @map("completed_at")
  pausedAt      DateTime? @map("paused_at")
  lastErrorCode String?  @map("last_error_code")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([completedAt, pausedAt, availableAt, id])
  @@map("work_outbox")
}

model SourceEventReview {
  id String @id @db.Uuid
  fixtureId String @map("fixture_id") @db.Uuid
  fixtureStateId String @map("fixture_state_id") @db.Uuid
  sourceEventId String @map("source_event_id")
  reason String
  sourceEvent Json @map("source_event")
  evidence Json
  status String @default("pending")
  decidedBy String? @map("decided_by")
  decisionReason String? @map("decision_reason")
  decidedAt DateTime? @map("decided_at")
  eventId String? @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  fixture Fixture @relation(fields: [fixtureId], references: [id])
  fixtureState FixtureState @relation(fields: [fixtureStateId], references: [id])
  event FootballEvent? @relation(fields: [eventId], references: [id])

  @@unique([fixtureId, sourceEventId])
  @@index([status, createdAt, id])
  @@index([fixtureStateId])
  @@index([eventId])
  @@map("source_event_reviews")
}

datasource db {
  provider = "postgresql"
}

model Competition {
  id        String   @id @db.Uuid
  source    String
  sourceId  String   @map("source_id")
  name      String
  slug      String
  country   String?
  season    Int
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  fixtures  Fixture[]

  @@unique([source, sourceId, season])
  @@unique([slug, season])
  @@index([enabled, priority])
  @@map("competitions")
}

model Team {
  id        String   @id @db.Uuid
  source    String
  sourceId  String   @map("source_id")
  name      String
  shortName String?  @map("short_name")
  country   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")
  events      FootballEvent[]

  @@unique([source, sourceId])
  @@map("teams")
}

model Player {
  id        String   @id @db.Uuid
  source    String
  sourceId  String   @map("source_id")
  name      String
  teamId    String?  @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  events    FootballEvent[]

  @@unique([source, sourceId])
  @@map("players")
}

model Fixture {
  id                 String   @id @db.Uuid
  source             String
  sourceFixtureId    String   @map("source_fixture_id")
  competitionId      String   @map("competition_id") @db.Uuid
  homeTeamId         String   @map("home_team_id") @db.Uuid
  awayTeamId         String   @map("away_team_id") @db.Uuid
  kickoffAt          DateTime @map("kickoff_at")
  status             String
  minute             Int?
  homeScore          Int      @default(0) @map("home_score")
  awayScore          Int      @default(0) @map("away_score")
  lastSourceUpdateAt DateTime? @map("last_source_update_at")
  lastPolledAt       DateTime? @map("last_polled_at")
  sourceReviewVersion Int @default(0) @map("source_review_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  competition        Competition @relation(fields: [competitionId], references: [id])
  homeTeam           Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team @relation("AwayTeam", fields: [awayTeamId], references: [id])
  states             FixtureState[]
  events             FootballEvent[]
  sourceReviews      SourceEventReview[]

  @@unique([source, sourceFixtureId])
  @@index([status, kickoffAt])
  @@index([competitionId, kickoffAt])
  @@map("fixtures")
}

model FixtureState {
  id        String   @id @db.Uuid
  fixtureId String   @map("fixture_id") @db.Uuid
  status    String
  minute    Int?
  homeScore Int      @map("home_score")
  awayScore Int      @map("away_score")
  rawHash   String   @map("raw_hash")
  sourceEvents Json? @map("source_events")
  capturedAt DateTime @default(now()) @map("captured_at")
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  sourceReviews SourceEventReview[]

  @@index([fixtureId, capturedAt])
  @@map("fixture_states")
}

model FootballEvent {
  id               String   @id @db.Uuid
  fixtureId        String   @map("fixture_id") @db.Uuid
  eventType        String   @map("event_type")
  sourceEventId    String?  @map("source_event_id")
  eventFingerprint String   @unique @map("event_fingerprint")
  minute           Int?
  extraTime        Int?     @map("extra_time")
  teamId           String?  @map("team_id") @db.Uuid
  playerId         String?  @map("player_id") @db.Uuid
  playerName       String?  @map("player_name")
  relatedEventId   String?  @map("related_event_id") @db.Uuid
  homeScore        Int?     @map("home_score")
  awayScore        Int?     @map("away_score")
  status           String   @default("confirmed")
  occurredAt       DateTime? @map("occurred_at")
  detectedAt       DateTime @default(now()) @map("detected_at")
  createdAt        DateTime @default(now()) @map("created_at")
  fixture          Fixture  @relation(fields: [fixtureId], references: [id])
  team             Team?    @relation(fields: [teamId], references: [id])
  player           Player?  @relation(fields: [playerId], references: [id])
  relatedEvent     FootballEvent? @relation("EventCorrections", fields: [relatedEventId], references: [id])
  corrections      FootballEvent[] @relation("EventCorrections")
  contentItems     ContentItem[]
  sourceReviews    SourceEventReview[]

  @@index([fixtureId, detectedAt])
  @@index([eventType, detectedAt])
  @@map("football_events")
}

model ContentItem {
  id           String   @id @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  channel      String
  contentType  String   @map("content_type")
  priority     String
  shortText    String   @map("short_text")
  standardText String   @map("standard_text")
  status       String   @default("published")
  createdAt    DateTime @default(now()) @map("created_at")
  publishedAt  DateTime? @map("published_at")
  event        FootballEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, channel, contentType])
  @@index([publishedAt, id])
  @@index([channel, publishedAt, id])
  @@map("content_items")
}

model ContentTemplate {
  id           String   @id @db.Uuid
  eventType    String   @map("event_type")
  templateType String   @map("template_type")
  language     String   @default("en")
  templateText String   @map("template_text")
  enabled      Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([eventType, templateType, language, version])
  @@map("content_templates")
}

model ApiClient {
  id          String   @id @db.Uuid
  name        String
  slug        String   @unique
  status      String   @default("enabled")
  keyPrefix   String   @unique @map("key_prefix")
  keyHash     String   @map("key_hash")
  rateLimit   Int      @default(120) @map("rate_limit")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  requestLogs ApiRequestLog[]

  @@map("api_clients")
}

model ApiRequestLog {
  id          String   @id @db.Uuid
  apiClientId String?  @map("api_client_id") @db.Uuid
  requestId   String   @map("request_id")
  method      String
  path        String
  statusCode  Int      @map("status_code")
  durationMs  Int      @map("duration_ms")
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  apiClient   ApiClient? @relation(fields: [apiClientId], references: [id])

  @@index([apiClientId, createdAt])
  @@index([requestId])
  @@map("api_request_logs")
}

model PollingRun {
  id               String   @id @db.Uuid
  provider         String
  status           String
  fixturesRetrieved Int     @default(0) @map("fixtures_retrieved")
  changedFixtures  Int      @default(0) @map("changed_fixtures")
  durationMs       Int?     @map("duration_ms")
  errorCode        String?  @map("error_code")
  startedAt        DateTime @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")

  @@index([startedAt])
  @@map("polling_runs")
}

model SystemIncident {
  id         String   @id @db.Uuid
  component  String
  severity   String
  code       String
  message    String
  status     String   @default("open")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([component, status])
  @@map("system_incidents")
}
