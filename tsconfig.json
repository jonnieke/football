{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "exclude": ["**/node_modules/**", "**/dist/**", "**/.vercel/**"],
  "include": [
    "apps/**/*.ts",
    "workers/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "tsup.runtime.config.ts",
    "prisma.config.ts"
  ]
}
